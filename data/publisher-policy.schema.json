{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "dataVersion": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}$"
    },
    "publishers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "pods": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "lastMajorOnCocoaPods": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "stoppedPublishing": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}$"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "swiftPackage": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "url",
              "note"
            ],
            "additionalProperties": false
          },
          "source": {
            "type": "string",
            "format": "uri"
          },
          "checked": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          }
        },
        "required": [
          "id",
          "name",
          "pods",
          "lastMajorOnCocoaPods",
          "stoppedPublishing",
          "summary",
          "source",
          "checked"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "dataVersion",
    "publishers"
  ],
  "additionalProperties": false
}
